# ---- Database ----
# DB_* are used by docker-compose to provision the Postgres container
DB_USER="admin"
DB_PASSWORD="change-me"
DB_NAME="csgrind"
# Connection string used by the app (Prisma)
DATABASE_URL="postgresql://admin:change-me@localhost:5432/csgrind?schema=public"

# ---- Backend ----
# JWT_SECRET must be at least 32 characters
JWT_SECRET="a-random-secret-of-at-least-32-characters"
STEAM_REALM="http://localhost:3000"
STEAM_RETURN_URL="http://localhost:3000/auth/steam/return"
STEAM_API_KEY="your-steam-web-api-key"
SITE_URL="http://localhost:5173"

# Optional (has a default) — server port, defaults to 3000
# PORT=3000
# Optional (has a default) — development | production | test, defaults to development
# NODE_ENV=development

# ---- Email (optional, mailer currently disabled) ----
RESEND_API="your-resend-api-key"
MAIL_FROM="CSGrind <onboarding@resend.dev>"
